# Production environment for bims-shopify.
# Copy this file to `.env` on the VPS host, next to docker-compose.yml, and fill in
# real values. `.env` is gitignored and read via `env_file: .env` in docker-compose.yml.

# --- Database (points at the per-app postgres service in docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://bims_shopify:bims_shopify@postgres:5432/bims_shopify

# --- App secrets ---
ADMIN_TOKEN=change-me-to-a-random-secret
FERNET_KEY=

# --- Sync behavior ---
SYNC_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- Shopify app credentials ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Public origin ---
# Builds the Shopify OAuth redirect_uri and the buyer-facing Bancard vPOS
# payment links. A stale value mints links to a dead host and buyers cannot
# pay, so always set it explicitly; it has no production default.
PUBLIC_BASE_URL=https://stocksync.tatalabs.com.py

# Hostnames Traefik routes to this service (see docker-compose.yml). Both are
# served at once so the public domain can move without downtime: point DNS at
# the host, cut PUBLIC_BASE_URL and the Shopify app URLs over, verify, and only
# then drop LEGACY_PUBLIC_HOST.
PUBLIC_HOST=stocksync.tatalabs.com.py
LEGACY_PUBLIC_HOST=mystoresync.ignitesolutions.click
