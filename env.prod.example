# Production environment for bims-shopify.
# Copy this file to `.env` on the VPS host, next to docker-compose.yml, and fill in
# real values. `.env` is gitignored and read via `env_file: .env` in docker-compose.yml.

# --- Database (points at the per-app postgres service in docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://bims_shopify:bims_shopify@postgres:5432/bims_shopify

# --- App secrets ---
ADMIN_TOKEN=change-me-to-a-random-secret
FERNET_KEY=

# --- Sync behavior ---
SYNC_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
ENVIRONMENT=production

# --- Shopify app credentials ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
PUBLIC_BASE_URL=https://mystoresync.ignitesolutions.click
