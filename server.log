a612612 (HEAD -> main, origin/main, origin/HEAD) feat: add catalog wipe/import ops commands driven from BIMS
-bash: gh: command not found
ubuntu@ignitesolutions-click:~/apps/bims-shopify$ cd ~/apps/bims-shopify

# 0. Sanity check: qué se va a importar (dry-run, no escribe nada)
docker compose -p bims-shopify exec -T app python -m bims_shopify.ops.catalog mystore import

# 1. Borrar el catálogo viejo (IRREVERSIBLE — imprime el conteo antes)
docker compose -p bims-shopify exec -T app python -m bims_shopify.ops.catalog mystore wipe --yes-i-mean-it

# 2. Smoke test: 20 productos reales en DRAFT
docker compose -p bims-shopify exec -T app python -m bims_shopify.ops.catalog mystore import --limit 20 --apply

# 3. Si el smoke se ve bien en el admin de Shopify → carga completa
docker compose -p bims-shopify exec -T app python -m bims_shopify.ops.catalog mystore import --apply
#    (agregá --only-with-stock si querés arrancar solo con lo vendible,
#     o --publish si los querés ACTIVE de una)
